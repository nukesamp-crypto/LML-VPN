# Local dependencies and build output
**/node_modules/
**/release-output/
**/.cache/
*.log

# User settings, credentials and local signing material
.env
.env.*
!.env.example
*.pfx
*.p12
*.jks
*.keystore

# Large Windows runtime binaries: built/fetched separately
/desktop/resources/bin/*.exe
/desktop/resources/bin/*.dll
/desktop/resources/bin/geoip.dat
/desktop/resources/bin/geosite.dat
/desktop/resources/bin/*.download
